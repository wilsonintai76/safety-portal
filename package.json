{
  "name": "portal-keselamatan-jkm",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test worker/src/pbac.test.ts",
    "version:bump": "node scripts/version.mjs bump",
    "version:show": "node scripts/version.mjs show",
    "prebuild": "node scripts/version.mjs build",
    "admin:create": "node scripts/create-admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply jkm-safety-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jkm-safety-db --remote",
    "deploy": "node scripts/version.mjs bump && npm run build && wrangler deploy",
    "deploy:only": "wrangler deploy",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.13.17",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
