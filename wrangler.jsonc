{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-keselamatan-jkm",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "",
    "PASSWORD_ITERATIONS": "100000",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jkm-safety-db",
      "database_id": "99b7b250-cffa-4472-8493-2f459b247ed9",
      "migrations_dir": "worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8ed83ffa8b1747cda320a397cd883084"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "jkm-safety-evidence"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
